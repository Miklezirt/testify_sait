SEED_ADMIN_PASSWORD=""
SEED_STAFF_EMAIL="staff@example.test"
SEED_STAFF_PASSWORD=""
# Demo reservations and fictitious guests. Set false for production.
SEED_DEMO="true"
POSTGRES_USER="rooms"
POSTGRES_PASSWORD="rooms_local"
POSTGRES_DB="rooms"
